    "ingest": "tsx src/jobs/ingest.ts",
    "fixtures:generate": "node scripts/generate-fixtures.mjs src/ingestion/fixtures",
    "match": "tsx src/jobs/match.ts",
    "score": "tsx src/jobs/score.ts",
    "seed": "tsx src/jobs/seed.ts",
    "vercel-build": "tsx src/jobs/migrate.ts --if-configured && next build"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@neondatabase/serverless": "^1.2.0",
    "@next/env": "^16.4.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.54.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.21.4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.64.0",
