# Site password (ADR-008). When set, every page requires it; leave empty for local development.
SITE_PASSWORD=

# Postgres (Neon). Required for the app and jobs at runtime; tests use in-memory PGlite.
DATABASE_URL=

# Pipeline runner (ADR-013). Optional: split `npm run pipeline` into ticks of this many ms, as
# on Vercel (default there: 200000); unset runs the CLI without a time budget. On the website keep
# it between 120000 and 250000: a Meta request unit may take up to 45 s, a collect unit up to 60 s,
# and budget + 50 s (hard abort) must fit in the 300 s function limit (Fluid compute required).
PIPELINE_TICK_BUDGET_MS=

# Daily automatic discovery (Vercel Cron, vercel.json). Vercel sends it as
# "Authorization: Bearer $CRON_SECRET"; unset → the cron route answers 503 and nothing runs
# automatically (the "start discovery" button still works). Use 32 random characters
# (at least 16), e.g. `openssl rand -hex 32`. Also keys the hand-off between ticks.
CRON_SECRET=

# Set to 1 to turn the pipeline off on this deployment (the e2e server does). The status route
# still answers, with "disabled": true.
PIPELINE_DISABLED=

# The pipeline runs only in production on Vercel (or locally). Set to 1 to allow it on Preview
# deployments; with Neon preview branching that sweeps Meta a second time from a copied database.
PIPELINE_ALLOW_PREVIEW=

# Shopify Global Catalog (UCP) agent profile URL. Optional: unset uses Shopify's example profile;
# set our own once the site is deployed (docs/DEPLOY.md).
SHOPIFY_UCP_AGENT_PROFILE=

# Data source credentials (see docs/loop/HUMAN_TODO.md). Not used by the pipeline yet; adapters for
# them are added once a key exists. Fixtures are only for automated tests, never shown on the site.
META_ACCESS_TOKEN=
SERPAPI_KEY=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
APIFY_TOKEN=
KEEPA_API_KEY=
CJ_API_KEY=
