# Site password (ADR-008). When set, every page requires it; leave empty for local development.
SITE_PASSWORD=

# Postgres (Neon). Required for the app and jobs at runtime; tests use in-memory PGlite.
DATABASE_URL=

# Pipeline runner (ADR-013). Optional: split `npm run pipeline` into ticks of this many ms, as
# on Vercel (default there: 200000); unset runs the CLI without a time budget.
PIPELINE_TICK_BUDGET_MS=

# Data source credentials (see docs/loop/HUMAN_TODO.md). Leave empty to use fixtures.
META_ACCESS_TOKEN=
SERPAPI_KEY=
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
APIFY_TOKEN=
KEEPA_API_KEY=
CJ_API_KEY=
